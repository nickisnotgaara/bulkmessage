# ============================================================
# TEMPLATE — скопируй в .env.local и подставь свои значения
# cp .env.example .env.local
# ============================================================
# ⚠️  .env.local НИКОГДА не коммитится. Все секреты — только там.
# ============================================================

# --- Data directory ---
BULK_DATA_DIR=data
BULK_EXCEL_PATH=data/Contact.xlsx
BULK_TEMPLATES_PATH=Message_script.md
BULK_LOG_PATH=data/broadcast_log.csv
BULK_STATE_PATH=data/broadcast_state.json
BULK_DB_PATH=data/crm.db
BULK_PENDING_WEBHOOKS=data/pending_webhooks.jsonl

# --- Timezone ---
# Сервер должен работать в одной TZ независимо от локальной.
BULK_TIMEZONE=Europe/Moscow

# --- Wazzup24 (единственный транспорт) ---
WAZZUP_BASE_URL=https://api.wazzup24.com
# API-ключ из личного кабинета Wazzup24 → Настройки → API.
WAZZUP_API_KEY=<your-wazzup-api-key>
# UUID канала по умолчанию (используется для WABA и как fallback для других).
WAZZUP_DEFAULT_CHANNEL_ID=<wazzup-channel-uuid>
# UUID канала для Telegram Personal / Bot (через Wazzup).
WAZZUP_TG_CHANNEL_ID=<wazzup-tg-channel-uuid>
# UUID канала для MAX Personal / Bot (через Wazzup).
WAZZUP_MAX_CHANNEL_ID=<wazzup-max-channel-uuid>
# UUID канала для WhatsApp Personal через Wazzup (опционально).
WAZZUP_WHATSAPP_CHANNEL_ID=
# Webhook URL, на который Wazzup шлёт events (для reply/status).
# Должен быть HTTPS и доступен извне (используй ngrok для локальной разработки).
WAZZUP_WEBHOOK_URL=
# HMAC-секрет для подписи webhook (опционально, но рекомендуется).
WAZZUP_HMAC_SECRET=
# Tier WABA (0..4). Если неизвестен — дефолт 0 (250/day).
WAZZUP_TIER_DEFAULT=0
# 1 = проверять HMAC-подпись webhook, 0 = пропускать без проверки.
WAZZUP_VERIFY_SIGNATURE=1

# --- WABA Templates (Phase 1.2) ---
# templateId в формате UUID от Meta Business Manager (WhatsApp → Message Templates).
# Берётся из колонки "API ID" / "templateId" одобренного шаблона.
# Если формат неверный — pick_waba_template вернёт None и cascade пойдёт через TG/MAX.
WABA_TEMPLATE_BUYER_ID=<uuid-of-buyer-template>
WABA_TEMPLATE_SELLER_ID=<uuid-of-seller-template>
WABA_TEMPLATE_AGENT_ID=<uuid-of-agent-template>
WABA_TEMPLATE_INVESTOR_ID=<uuid-of-investor-template>

# --- Google Sheets ---
# ID таблицы из URL: docs.google.com/spreadsheets/d/<ID>/edit
# Service account: создай в Google Cloud Console → скачай credentials.json
# → положи в корень проекта (НЕ коммитится, в .gitignore).
BULK_GOOGLE_SHEET_ID=<your-google-sheet-id>
BULK_GOOGLE_CREDENTIALS_JSON=credentials.json
BULK_GOOGLE_WORKSHEET=Messages

# --- Webhook server (tracker) ---
BULK_WEBHOOK_HOST=127.0.0.1
BULK_WEBHOOK_PORT=8000
BULK_WEBHOOK_PATH=/webhook

# --- Reconciliation ---
BULK_RECONCILE_INTERVAL=60
BULK_STATUS_POLL_AGE=30
BULK_STATUS_POLL_LIMIT=100
BULK_SHEETS_RETRY_LIMIT=5

# --- Рассылка ---
# Дневной лимит per channel (headroom 25% считается автоматически).
# Hard cap для Personal каналов — 30/день (защита от бана оригинальных аккаунтов).
# WABA tier-0 → 250/день, tier 1 → 1000, tier 2 → 10000, tier 3 → 100000.
BULK_LIMIT_WHATSAPP=60
BULK_LIMIT_TELEGRAM=30
BULK_LIMIT_MAX=30
BULK_LIMIT_WABA=250

# Cascade-режим: 1 = WABA→TG→MAX, 0 = legacy WA→TG→MAX.
BULK_USE_WABA=1

# Анти-бан: 1 контакт каждые 5-15 мин (avg 10 мин) → ~60 контактов за 10 часов.
# Пауза в СЕКУНДАХ между КОНТАКТАМИ (не между каналами!).
BULK_DELAY_MIN=300
BULK_DELAY_MAX=900

# Batch-брейки отключены — "перерывы" теперь это рандом 5-15 мин.
BULK_BATCH_SIZE=1000
BULK_BATCH_BREAK_MIN=0
BULK_BATCH_BREAK_MAX=0

# Активное окно отправки (по Москве, см. BULK_TIMEZONE):
# 10:00 — старт, 20:00 — стоп. Вне этого окна sender спит до следующего 10:00.
BULK_ACTIVE_HOURS_START=10
BULK_ACTIVE_HOURS_END=20

# Режим "только тест" — НЕ шлёт реальные сообщения, только имитирует.
# ⚠️  0 только в боевом режиме, 1 — для тестов расписания.
BULK_DRY_RUN=1

# Backoff (когда Wazzup ругается на rate limit / timeout):
# 429/flood wait — экспоненциальный backoff от 5 мин до 1ч.
# 5xx/timeout — случайный 30-120 сек.
# 401/403 — сразу максимальный (токен надо чинить руками).
BULK_RATE_BACKOFF_BASE=300
BULK_RATE_BACKOFF_MAX=3600
BULK_TRANSIENT_BACKOFF_MIN=30
BULK_TRANSIENT_BACKOFF_MAX=120
BULK_TRANSIENT_RETRY=1

# Telegram-бот для уведомлений админу (ошибки + ключевые события рассылки).
# Создай бота через @BotFather, получи токен.
# Свой chat_id можно узнать через @userinfobot.
# ⚠️  Токен бота = секрет. Если утек — /revoke в @BotFather.
BULK_TG_LOG_BOT_TOKEN=<your-telegram-bot-token>
BULK_TG_LOG_ADMIN_ID=<your-telegram-chat-id>
# ERROR (только ошибки), WARNING (ошибки+предупреждения), INFO (всё важное)
BULK_TG_LOG_LEVEL=ERROR
# Мин. секунд между сообщениями (Telegram rate limit)
BULK_TG_LOG_SEND_INTERVAL=2.0
# Макс. очередь сообщений (если бот недоступен, дропаем после N)
BULK_TG_LOG_MAX_QUEUE=1000
# ============================================================
# SMS.RU (fallback-канал последней надежды, отдельный транспорт)
# ============================================================
# Каскад: WABA -> Telegram -> MAX -> SMS. SMS только если все мессенджеры
# провалились. НЕ транспорт Wazzup24 — свой API-клиент bulkmessage/sms_ru.py.
#
# ⚠️  Без BULK_SMSRU_SENDER_NAME SMS.RU отвечает ошибкой 221: имя отправителя
#    должно быть зарегистрировано в SMS.RU (лат. буквы, 3-11 символов).
# ⚠️  Шаблоны SMS живут в Message_script_sms.md и ОБЯЗАНЫ быть короче
#    140 символов (2 сегмента). Мессенджерные тексты стоили бы 42-51 ₽.
BULK_SMSRU_ENABLED=1
# СЕКРЕТ. Только в .env.local, никогда не коммитить.
BULK_SMSRU_API_ID=
# Зарегистрированный буквенный отправитель (3-11 лат. букв).
BULK_SMSRU_SENDER_NAME=
# 1 = test=1 ко всем вызовам (SMS.RU ничего не доставляет, баланс не тратится).
BULK_SMSRU_TEST_MODE=1
# Бюджет длины SMS: 2 сегмента = 140 символов ≈ 17 ₽. SMS.RU отвергает >8.
BULK_SMSRU_MAX_SEGMENTS=2
# Номер для preflight smoke-теста (test=1 — ничего не отправляется).
BULK_SMSRU_TEST_PHONE=79000000000
# Дневной лимит SMS (при headroom 25% даёт 37 SMS/день ≈ 314 ₽).
# НЕ ограничен MAX_PERSONAL_DAILY_HARD_CAP: SMS идёт через агрегатор,
# а не через оригинальный личный аккаунт мессенджера.
BULK_LIMIT_SMS=50
# Safe hours для SMS (по умолчанию как у Personal: 11-19).
BULK_SMS_SAFE_HOURS_START=11
BULK_SMS_SAFE_HOURS_END=19
# Per-phone cooldown после SMS: 4 дня.
BULK_SMS_COOLDOWN_HOURS=96
# Жалоба блокирует имя отправителя у всех операторов -> строгий порог 2.
BULK_COMPLAINT_HALT_SMS=2
# Пауза между контактами после SMS (короче PERSONAL_DELAY: SMS стоит денег).
BULK_SMS_DELAY_MIN=30
BULK_SMS_DELAY_MAX=90
